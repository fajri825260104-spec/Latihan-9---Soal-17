#include <stdio.h>
#include <string.h>
#include <ctype.h>

// Fungsi bantu untuk mengubah string ke huruf kecil agar pencarian lebih fleksibel
void to_lower_case(char *str) {
    for(int i = 0; str[i]; i++){
        str[i] = tolower(str[i]);
    }
}

// a. Fungsi untuk menghitung biaya asuransi untuk tiap jenis ladang
float hitung_asuransi(char *jenis_ladang, float nilai_tanggungan_per_hektar, float luas_hektar) {
    // Biaya standar adalah 3.5 persen dari nilai tanggungan dikalikan luas tanah
    float biaya_standar = 0.035 * nilai_tanggungan_per_hektar * luas_hektar;
    
    char jenis[50];
    strcpy(jenis, jenis_ladang);
    to_lower_case(jenis);

    // Ladang kacang kedelai, kentang, bawang merah, dan cabai (2x biaya standar)
    if (strcmp(jenis, "kacang kedelai") == 0 || strcmp(jenis, "kentang") == 0 || 
        strcmp(jenis, "bawang merah") == 0 || strcmp(jenis, "cabai") == 0) {
        return 2 * biaya_standar;
    }
    // Ladang padi, singkong, dan jagung (1.5x biaya standar)
    else if (strcmp(jenis, "padi") == 0 || strcmp(jenis, "singkong") == 0 || strcmp(jenis, "jagung") == 0) {
        return 1.5 * biaya_standar;
    }
    else {
        return biaya_standar;
    }
}

